 // botones "Agregar" de las tarjetas de producto -> carrito + avisito
 function toastB(m){var t=document.getElementById('buumToast');if(!t){t=document.createElement('div');t.id='buumToast';t.style.cssText='position:fixed;bottom:88px;left:50%;transform:translateX(-50%) translateY(20px);background:#001866;color:#fff;padding:10px 18px;border-radius:12px;font-size:13px;font-weight:600;z-index:60;opacity:0;transition:.3s;box-shadow:0 8px 24px rgba(0,0,0,.35);max-width:88%;text-align:center';document.body.appendChild(t);}t.textContent=m;requestAnimationFrame(function(){t.style.opacity='1';t.style.transform='translateX(-50%) translateY(0)';});clearTimeout(t._h);t._h=setTimeout(function(){t.style.opacity='0';t.style.transform='translateX(-50%) translateY(20px)';},2200);}
 function cartAddSilent(code){var p=CAT[code];if(!p)return;var f=CART.filter(function(x){return x.code===code;})[0];if(f){f.qty++;}else{CART.push({code:code,qty:1});}localStorage.setItem('buum_cart',JSON.stringify(CART));updateCartBadge();toastB('✓ '+p.n+' agregado al carrito 🛒');}
 document.addEventListener('click',function(e){var b=e.target.closest('[data-addcart]');if(b){e.preventDefault();cartAddSilent(b.getAttribute('data-addcart'));}});
 function reply(q){q=(q||'').toLowerCase();var r;
  var PC='<div class="pcard"><img src="'+FOCO+'"><div><b>Reflector Solar 50W</b><div class="pp">2 x $1,299 · ilumina como 500W</div></div></div><a class="addbtn" href="'+PURL+'">Ver y comprar</a>';
  if(/lluvia|agua|moja|intemperie|clima/.test(q)){
   r='Sí. Está hecho para exteriores: resiste <b>lluvia, sol y polvo</b> (no sumergible). Lo instalas afuera sin problema.'+PC;
