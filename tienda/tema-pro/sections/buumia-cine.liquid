 function addToCart(code){var p=CAT[code];if(!p)return;var f=CART.filter(function(x){return x.code===code;})[0];if(f){f.qty++;}else{CART.push({code:code,qty:1});}localStorage.setItem('buum_cart',JSON.stringify(CART));updateCartBadge();
