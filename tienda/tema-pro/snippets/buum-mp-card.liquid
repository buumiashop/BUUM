{%- comment -%} Tarjeta de producto estilo marketplace. Params: product, show_discount {%- endcomment -%}
{%- liquid
  assign p = product
  assign disc = 0
  if p.compare_at_price > p.price
    assign diff = p.compare_at_price | minus: p.price | times: 100.0
    assign disc = diff | divided_by: p.compare_at_price | round
  endif
-%}
<a href="{{ p.url }}" class="mp-pcard">
  <div class="mp-pmedia">
    {%- if show_discount and disc > 0 -%}<span class="mp-disc">-{{ disc }}%</span>{%- endif -%}
    {%- if p.featured_image -%}
      <img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="500" height="500">
    {%- else -%}
      {%- render 'buumia-icon', name: 'bulb' -%}
    {%- endif -%}
  </div>
  <div class="mp-pbody">
    <div class="mp-pname">{{ p.title }}</div>
    <div>
      <span class="mp-pprice">{{ p.price | money }}</span>
      {%- if p.compare_at_price > p.price -%}<span class="mp-pwas">{{ p.compare_at_price | money }}</span>{%- endif -%}
    </div>
    <span class="mp-pbuy">Comprar</span>
  </div>
</a>
