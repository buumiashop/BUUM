<header class="mp-header">
  <div class="mp-top">
    <a href="{{ routes.root_url }}" class="mp-logo">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" width="160" height="46" style="height:auto;max-height:46px;width:auto">
      {%- else -%}
        <span class="b">BUUM</span><span class="ia">IA</span>
      {%- endif -%}
    </a>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mp-search">
      <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" aria-label="Buscar">
      <button type="submit" aria-label="Buscar">{%- render 'buumia-icon', name: 'search' -%}<span class="visually-hidden">Buscar</span></button>
    </form>

    <div class="mp-act">
      <a href="{{ routes.account_url }}" class="mp-ico">{%- render 'buumia-icon', name: 'user' -%}<span>Mi cuenta</span></a>
      <a href="{{ routes.cart_url }}" class="mp-ico">
        {%- render 'buumia-icon', name: 'cart' -%}<span>Carrito</span>
        <span class="mp-badge">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
  <nav class="mp-deps" aria-label="Departamentos">
    <div class="mp-deps-in">
      <span class="all" style="color:#fff;padding:5px 12px;border-radius:7px">{%- render 'buumia-icon', name: 'menu' -%} Departamentos</span>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {% if block.settings.highlight %}class="hot"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  </nav>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "BUUM · Encabezado MP",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional)" },
    { "type": "text", "id": "search_placeholder", "label": "Texto del buscador", "default": "Buscar focos, lámparas solares, ventiladores E27…" }
  ],
  "blocks": [
    {
      "type": "dep",
      "name": "Departamento",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Departamento" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "checkbox", "id": "highlight", "label": "Resaltar (amarillo)", "default": false }
      ]
    }
  ]
}
{% endschema %}
