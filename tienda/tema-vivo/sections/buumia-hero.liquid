{{ 'buumia.css' | asset_url | stylesheet_tag }}
<div class="buum-stage buum-hero-stage">
  <span class="buum-glow" style="left:6%;top:18%;width:120px;height:120px;background:radial-gradient(circle,rgba(234,80,3,.5),transparent 70%);animation-delay:0s"></span>
  <span class="buum-glow" style="right:8%;top:30%;width:150px;height:150px;background:radial-gradient(circle,rgba(16,42,196,.4),transparent 70%);animation-delay:1.2s"></span>
  <span class="buum-glow" style="left:18%;bottom:8%;width:100px;height:100px;background:radial-gradient(circle,rgba(255,170,80,.55),transparent 70%);animation-delay:.6s"></span>
  <span class="buum-glow" style="right:20%;bottom:14%;width:130px;height:130px;background:radial-gradient(circle,rgba(234,80,3,.4),transparent 70%);animation-delay:1.8s"></span>

  <div class="buum-inner">
    <div class="buum-hero buum-reveal">
      {%- if section.settings.show_bulb -%}<span class="buum-hero__bulb">💡</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="buum-hero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="buum-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="buum-btns">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="buum-btn buum-btn--primary">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="buum-btn buum-btn--ghost">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="buum-trust buum-reveal">
        {%- for block in section.blocks -%}
          <span class="buum-trust__item" {{ block.shopify_attributes }}>
            <span class="buum-ic">{%- render 'buumia-icon', name: block.settings.icon -%}</span>
            {{ block.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "BUUMIA · Hero",
  "tag": "section",
  "class": "buumia-section",
  "settings": [
    { "type": "checkbox", "id": "show_bulb", "label": "Mostrar foco animado", "default": true },
    { "type": "text", "id": "heading", "label": "Título", "default": "Ilumina tu casa, brilla tu estilo" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Productos que sí sirven, al mejor precio." },
    { "type": "text", "id": "button_label_1", "label": "Botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link_1", "label": "Enlace botón principal" },
    { "type": "text", "id": "button_label_2", "label": "Botón secundario", "default": "Ver catálogo" },
    { "type": "url", "id": "button_link_2", "label": "Enlace botón secundario" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Punto de confianza",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono", "default": "truck",
          "options": [
            { "value": "truck", "label": "Camión / envío" },
            { "value": "lock", "label": "Candado / seguro" },
            { "value": "chat", "label": "Chat / WhatsApp" },
            { "value": "shield", "label": "Escudo" },
            { "value": "star", "label": "Estrella" },
            { "value": "bolt", "label": "Rayo" },
            { "value": "bulb", "label": "Foco" }
          ]
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Envíos a todo México" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "BUUMIA · Hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "truck", "text": "Envíos a todo México" } },
        { "type": "trust", "settings": { "icon": "lock", "text": "Pago seguro" } },
        { "type": "trust", "settings": { "icon": "chat", "text": "Atención por WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
